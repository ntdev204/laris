{
  "$defs": {
    "Agent": {
      "additionalProperties": false,
      "description": "Limits of the agent loop.",
      "properties": {
        "maxRepeatedCalls": {
          "default": 3,
          "description": "Identical calls refused in one turn before the turn stops. Each refusal is returned to the model as an error so\nit can change approach or answer; 1 stops at the first repeat.",
          "format": "uint32",
          "maximum": 10,
          "minimum": 1,
          "type": "integer"
        },
        "maxSteps": {
          "default": 10,
          "description": "Model calls in one turn (the orchestration specification caps it at 10).",
          "format": "uint32",
          "maximum": 10,
          "minimum": 1,
          "type": "integer"
        },
        "maxToolCallsPerStep": {
          "default": 0,
          "description": "Tool calls run in one model step; more are refused. 0 sets no limit (the default): a step is still bounded by\n`maxSteps` and `timeBudgetSeconds`.",
          "format": "uint32",
          "maximum": 64,
          "minimum": 0,
          "type": "integer"
        },
        "plan": {
          "$ref": "#/$defs/PlanSettings",
          "default": {
            "maxSteps": 12,
            "minRequestWords": 12,
            "mode": "auto",
            "stepChars": 240
          },
          "description": "Planning."
        },
        "reflect": {
          "$ref": "#/$defs/Reflect",
          "default": {
            "completionRetries": 2,
            "emptyKeys": [
              "hits",
              "passages",
              "results",
              "matches",
              "items"
            ],
            "enabled": true,
            "maxReplans": 2,
            "permanentErrors": [
              "no_documents",
              "search_blocked",
              "web_unavailable"
            ]
          },
          "description": "Reflection and completion check."
        },
        "timeBudgetSeconds": {
          "default": 180.0,
          "description": "Longest time of one turn, in seconds.",
          "exclusiveMinimum": 0,
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "Context": {
      "additionalProperties": false,
      "description": "Context window, autocompact and the budget of the prompt layer.",
      "properties": {
        "autoCompact": {
          "default": true,
          "description": "Compact automatically near the limit.",
          "type": "boolean"
        },
        "compactTarget": {
          "default": 0.75,
          "description": "Fraction of the compaction trigger that compaction aims for.",
          "exclusiveMinimum": 0,
          "format": "double",
          "maximum": 1,
          "type": "number"
        },
        "compactThreshold": {
          "default": 0.8,
          "description": "Fraction of the window at which compaction starts.",
          "exclusiveMinimum": 0,
          "format": "double",
          "maximum": 1,
          "type": "number"
        },
        "layerMaxChars": {
          "default": 20000,
          "description": "Characters read from one `LARIS.md` or memory file.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "layerShare": {
          "default": 0.25,
          "description": "Share of the available tokens the `LARIS.md` layers and memory may take together.",
          "exclusiveMinimum": 0,
          "format": "double",
          "maximum": 1,
          "type": "number"
        },
        "memoryMaxNotes": {
          "default": 50,
          "description": "Memory notes read for a request.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "pinnedShare": {
          "default": 0.25,
          "description": "Share of the available tokens the pinned items may take; they are never cut.",
          "exclusiveMinimum": 0,
          "format": "double",
          "maximum": 1,
          "type": "number"
        },
        "reserveTokens": {
          "default": 4096,
          "description": "Tokens kept free for the answer.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "summaryLineChars": {
          "default": 160,
          "description": "Characters of a request or an answer kept in the compaction summary.",
          "format": "uint64",
          "minimum": 20,
          "type": "integer"
        },
        "summaryShare": {
          "default": 0.15,
          "description": "Share of the available tokens the compaction summary may take.",
          "exclusiveMinimum": 0,
          "format": "double",
          "maximum": 1,
          "type": "number"
        },
        "windowTokens": {
          "default": 32768,
          "description": "Window size in tokens.",
          "format": "uint64",
          "minimum": 1024,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "ExportRating": {
      "description": "Which rated examples `laris learn export` writes.",
      "oneOf": [
        {
          "const": "none",
          "description": "Everything that was not rated down.",
          "type": "string"
        },
        {
          "const": "up",
          "description": "Only what was rated up.",
          "type": "string"
        }
      ]
    },
    "HookCommand": {
      "additionalProperties": false,
      "description": "A command hook.",
      "properties": {
        "command": {
          "description": "Shell command.",
          "minLength": 1,
          "type": "string"
        },
        "timeout": {
          "default": 30.0,
          "description": "Timeout in seconds.",
          "exclusiveMinimum": 0,
          "format": "double",
          "maximum": 600,
          "type": "number"
        },
        "type": {
          "const": "command",
          "default": "command",
          "description": "Always `command`.",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    "HookMatcher": {
      "additionalProperties": false,
      "description": "Hooks that run for tools matching `matcher`.",
      "properties": {
        "hooks": {
          "default": [],
          "description": "Commands to run.",
          "items": {
            "$ref": "#/$defs/HookCommand"
          },
          "type": "array"
        },
        "matcher": {
          "default": "",
          "description": "Tool-name pattern; empty matches all.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Language": {
      "description": "Interface language of the catalogue.",
      "oneOf": [
        {
          "const": "en",
          "description": "English.",
          "type": "string"
        },
        {
          "const": "vi",
          "description": "Vietnamese.",
          "type": "string"
        }
      ]
    },
    "Learning": {
      "additionalProperties": false,
      "description": "Learning data collection (kept on the machine, ADR-021 D40).",
      "properties": {
        "collect": {
          "default": true,
          "description": "Derive learning examples from sessions.",
          "type": "boolean"
        },
        "exportMinRating": {
          "$ref": "#/$defs/ExportRating",
          "default": "none",
          "description": "Rating an example needs to be exported (`none`: every one that was not rated down)."
        },
        "maxToolResultChars": {
          "default": 3000,
          "description": "Longest tool result (characters) kept in an example; longer ones are cut.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "minAnswerChars": {
          "default": 40,
          "description": "Shortest final answer (characters) that becomes an example.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "retrievalTools": {
          "default": [
            "search_corpus"
          ],
          "description": "Names of the tools whose results are retrieval hits.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "storePassageText": {
          "default": true,
          "description": "Keep the passage text of retrieval examples; otherwise only identifiers and hashes.",
          "type": "boolean"
        },
        "storeToolResults": {
          "default": true,
          "description": "Keep tool results in examples; otherwise they are replaced by `[omitted]`.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "Mcp": {
      "additionalProperties": false,
      "description": "MCP servers (SR-H16): extra tools the user adds. None is configured by default. Read from the user's own settings only.",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Whether MCP servers are started at all.",
          "type": "boolean"
        },
        "servers": {
          "additionalProperties": {
            "$ref": "#/$defs/McpServer"
          },
          "default": {},
          "description": "Servers by name; the name becomes part of the tool names (`mcp__<name>__<tool>`).",
          "type": "object"
        }
      },
      "type": "object"
    },
    "McpServer": {
      "additionalProperties": false,
      "description": "One MCP server the client starts as a child process and talks to over standard input and output.",
      "properties": {
        "args": {
          "default": [],
          "description": "Arguments of the program.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "callTimeoutSeconds": {
          "default": 60,
          "description": "Seconds one tool call may take.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "command": {
          "default": "",
          "description": "Program to run (for example `uvx` or `npx`).",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "description": "Whether the server is started.",
          "type": "boolean"
        },
        "env": {
          "default": [],
          "description": "Names of environment variables passed to the server; the values are read from this process's environment\nand never stored in the settings. The server is skipped while one of them is unset.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "startTimeoutSeconds": {
          "default": 120,
          "description": "Seconds the start (handshake and tool list) may take; the first start may download the server.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Ocr": {
      "additionalProperties": false,
      "description": "External programs that read a PDF when the built-in reader gives no usable text (T261). Names are looked up on\n`PATH`; nothing is installed or downloaded. An empty command turns that step off.",
      "properties": {
        "dpi": {
          "default": 200,
          "description": "Resolution the pages are rendered at.",
          "format": "uint32",
          "maximum": 600,
          "minimum": 72,
          "type": "integer"
        },
        "enabled": {
          "default": true,
          "description": "Try the external readers at all.",
          "type": "boolean"
        },
        "languages": {
          "default": "eng",
          "description": "Recognition languages, joined by `+` (`eng+vie`).",
          "type": "string"
        },
        "maxPages": {
          "default": 60,
          "description": "Most pages recognised in one document.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "ocrCommand": {
          "default": "tesseract",
          "description": "Program that reads an image (`tesseract`).",
          "type": "string"
        },
        "renderCommand": {
          "default": "pdftoppm",
          "description": "Program that renders PDF pages to PNG images (`pdftoppm`).",
          "type": "string"
        },
        "textCommand": {
          "default": "pdftotext",
          "description": "Program that prints the text layer of a PDF (`pdftotext`); tried before OCR.",
          "type": "string"
        },
        "timeoutSeconds": {
          "default": 120,
          "description": "Longest one external program may run, in seconds.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "PermissionMode": {
      "description": "Permission mode.",
      "oneOf": [
        {
          "const": "auto",
          "description": "Run reads, writes and commands without asking, except the calls `autoAsk` names.",
          "type": "string"
        },
        {
          "const": "default",
          "description": "Ask before writes and commands.",
          "type": "string"
        },
        {
          "const": "acceptEdits",
          "description": "Accept file edits without asking.",
          "type": "string"
        },
        {
          "const": "plan",
          "description": "Plan only; deny changes.",
          "type": "string"
        },
        {
          "const": "bypass",
          "description": "Skip permission prompts.",
          "type": "string"
        }
      ]
    },
    "Permissions": {
      "additionalProperties": false,
      "description": "Permission mode and rules.",
      "properties": {
        "additionalDirectories": {
          "default": [],
          "description": "Directories outside the project that tools may touch.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "allow": {
          "default": [],
          "description": "Rules that allow.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ask": {
          "default": [],
          "description": "Rules that ask.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "autoAsk": {
          "default": [
            "Bash(sudo:*)",
            "Bash(su:*)",
            "Bash(doas:*)",
            "Bash(rm -[rRf]* /*)",
            "Bash(rm -[rRf]* ~*)",
            "Bash(rm -[rRf]* ..*)",
            "Bash(rm -[rRf]* $HOME*)",
            "Bash(git push:*)",
            "Bash(git reset --hard*)",
            "Bash(git clean:*)",
            "Bash(git branch -D:*)",
            "Bash(mkfs*)",
            "Bash(dd:*)",
            "Bash(chmod -R:*)",
            "Bash(chown -R:*)",
            "Bash(shutdown:*)",
            "Bash(reboot:*)",
            "Bash(poweroff:*)",
            "Bash(halt:*)"
          ],
          "description": "In `auto` mode, the calls that still ask: destructive commands. A list here replaces the default one.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "defaultMode": {
          "$ref": "#/$defs/PermissionMode",
          "default": "auto",
          "description": "Mode when a rule does not decide."
        },
        "deny": {
          "default": [],
          "description": "Rules that deny.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "PlanMode": {
      "description": "When the agent makes a visible plan.",
      "oneOf": [
        {
          "const": "off",
          "description": "No plan, and `update_plan` is not offered.",
          "type": "string"
        },
        {
          "const": "auto",
          "description": "A plan for requests of at least `minRequestWords` words.",
          "type": "string"
        },
        {
          "const": "always",
          "description": "A plan for every request.",
          "type": "string"
        }
      ]
    },
    "PlanSettings": {
      "additionalProperties": false,
      "description": "Agentic planning: a visible, tracked plan for goals that take several steps.",
      "properties": {
        "maxSteps": {
          "default": 12,
          "description": "Most steps in a plan.",
          "format": "uint32",
          "maximum": 30,
          "minimum": 1,
          "type": "integer"
        },
        "minRequestWords": {
          "default": 12,
          "description": "`auto`: requests with at least this many words count as multi-step.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "mode": {
          "$ref": "#/$defs/PlanMode",
          "default": "auto",
          "description": "When a plan is made."
        },
        "stepChars": {
          "default": 240,
          "description": "Longest text of a step, in characters.",
          "format": "uint32",
          "minimum": 20,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Reflect": {
      "additionalProperties": false,
      "description": "After each tool result the loop checks progress; a failed or empty step allows a bounded replan, and a goal\ncloses only when its plan is done.",
      "properties": {
        "completionRetries": {
          "default": 2,
          "description": "Times a goal with open steps is sent back to the model before it is reported open.",
          "format": "uint32",
          "maximum": 3,
          "minimum": 0,
          "type": "integer"
        },
        "emptyKeys": {
          "default": [
            "hits",
            "passages",
            "results",
            "matches",
            "items"
          ],
          "description": "Result keys whose empty value means the step found nothing.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "enabled": {
          "default": true,
          "description": "Check progress and completion.",
          "type": "boolean"
        },
        "maxReplans": {
          "default": 2,
          "description": "Replans allowed in one turn.",
          "format": "uint32",
          "maximum": 5,
          "minimum": 0,
          "type": "integer"
        },
        "permanentErrors": {
          "default": [
            "no_documents",
            "search_blocked",
            "web_unavailable"
          ],
          "description": "Error codes no change of approach can fix: the loop says so once instead of asking for a replan.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Sandbox": {
      "additionalProperties": false,
      "description": "Sandbox for code the model runs.",
      "properties": {
        "indexUrl": {
          "default": "",
          "description": "Package index address; empty for the default.",
          "type": "string"
        },
        "inheritEnv": {
          "default": false,
          "description": "Whether the sandbox inherits the environment.",
          "type": "boolean"
        },
        "packages": {
          "default": [],
          "description": "Packages preinstalled in the sandbox.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "python": {
          "default": "3.12",
          "description": "Python version of the sandbox.",
          "type": "string"
        },
        "pythonSource": {
          "default": "",
          "description": "Where to fetch the interpreter; empty for the default.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Server": {
      "additionalProperties": false,
      "description": "Server connection.",
      "properties": {
        "caCertificateFile": {
          "default": "",
          "description": "File holding the certificate of the pinned authority (PEM or DER); empty for none. Needed when\n`caFingerprint` is set: the fingerprint is checked against this file.",
          "type": "string"
        },
        "caFingerprint": {
          "default": "",
          "description": "`sha256:<hex>` of the pinned private certificate; empty for none.",
          "type": "string"
        },
        "idleTimeoutSeconds": {
          "default": 60.0,
          "description": "Longest silence inside a streamed or downloaded body, in seconds.",
          "exclusiveMinimum": 0,
          "format": "double",
          "type": "number"
        },
        "maxResponseBytes": {
          "default": 16777216,
          "description": "Largest accepted stream event or JSON answer, in bytes.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "maxRetries": {
          "default": 3,
          "description": "Extra attempts after the first, before a stream has started.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "retryBackoffMaxSeconds": {
          "default": 30.0,
          "description": "Longest wait between retries, in seconds; a `Retry-After` of the server is cut to this.",
          "exclusiveMinimum": 0,
          "format": "double",
          "type": "number"
        },
        "retryBackoffSeconds": {
          "default": 1.0,
          "description": "Wait before the first retry, in seconds; doubles each time.",
          "exclusiveMinimum": 0,
          "format": "double",
          "type": "number"
        },
        "timeoutSeconds": {
          "default": 120.0,
          "description": "Longest wait for the answer headers of one attempt, in seconds.",
          "exclusiveMinimum": 0,
          "format": "double",
          "type": "number"
        },
        "url": {
          "default": "",
          "description": "Server address; empty until the user or the package sets it.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "StatusLine": {
      "additionalProperties": false,
      "description": "Status line command.",
      "properties": {
        "command": {
          "description": "Shell command.",
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "command",
          "default": "command",
          "description": "Always `command`.",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    "Theme": {
      "description": "Colour theme.",
      "oneOf": [
        {
          "const": "auto",
          "description": "Follow the terminal.",
          "type": "string"
        },
        {
          "const": "light",
          "description": "Light.",
          "type": "string"
        },
        {
          "const": "dark",
          "description": "Dark.",
          "type": "string"
        }
      ]
    },
    "Tools": {
      "additionalProperties": false,
      "description": "Limits of the local tools (`Read`, `Write`, `Edit`, `Glob`, `Grep`, `Bash`, `save_memory`, skills) and of every\ntool result.",
      "properties": {
        "bashDefaultTimeoutSeconds": {
          "default": 120.0,
          "description": "Time a `Bash` command gets when it names none, in seconds.",
          "exclusiveMinimum": 0,
          "format": "double",
          "type": "number"
        },
        "bashMaxTimeoutSeconds": {
          "default": 600.0,
          "description": "Longest time a `Bash` command may ask for, in seconds.",
          "exclusiveMinimum": 0,
          "format": "double",
          "type": "number"
        },
        "bashOutputMaxChars": {
          "default": 30000,
          "description": "Characters of `Bash` output kept.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "checkpointKeep": {
          "default": 200,
          "description": "Edits kept for `/rewind`.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "deniedFiles": {
          "default": [
            ".env",
            ".env.*",
            "*.pem",
            "*.key",
            "id_rsa",
            "id_ed25519",
            ".netrc",
            ".npmrc",
            ".pypirc"
          ],
          "description": "File names (`*` and `?` match) that no tool reads or writes: secrets and keys.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "editMaxBytes": {
          "default": 2000000,
          "description": "Largest file `Read`, `Write` and `Edit` handle, in bytes.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "globMaxResults": {
          "default": 500,
          "description": "Files `Glob` lists at most.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "grepMaxFileBytes": {
          "default": 2000000,
          "description": "Files larger than this are not searched by `Grep`, in bytes.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "grepMaxResults": {
          "default": 200,
          "description": "Matches `Grep` returns at most.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "readMaxLines": {
          "default": 2000,
          "description": "Lines `Read` returns at most.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "resultMaxChars": {
          "default": 60000,
          "description": "Characters of one tool result, local or remote, passed to the model; more is cut.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "skillMaxChars": {
          "default": 20000,
          "description": "Characters of a skill's instructions kept.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Ui": {
      "additionalProperties": false,
      "description": "Terminal interface.",
      "properties": {
        "language": {
          "$ref": "#/$defs/Language",
          "default": "en",
          "description": "Language of the interface messages ([`crate::Catalogue`])."
        },
        "markdown": {
          "default": true,
          "description": "Render Markdown.",
          "type": "boolean"
        },
        "showStatusLine": {
          "default": true,
          "description": "Show the status line.",
          "type": "boolean"
        },
        "spinner": {
          "default": true,
          "description": "Show the spinner.",
          "type": "boolean"
        },
        "theme": {
          "$ref": "#/$defs/Theme",
          "default": "auto",
          "description": "Colour theme."
        }
      },
      "type": "object"
    },
    "Update": {
      "additionalProperties": false,
      "description": "Where the client finds its own new releases. Updating is always on: with no address (a development build) there\nis nothing to check. A release build carries both values (`LARIS_BUILD_DEFAULTS`).",
      "properties": {
        "intervalMinutes": {
          "default": 360,
          "description": "Minutes between two checks while the client runs.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "signatureVerifier": {
          "default": "",
          "description": "The release signing key, PEM or its base64 body; empty for none. A release is installed only when its\nchecksum list is signed with this key.",
          "type": "string"
        },
        "url": {
          "default": "",
          "description": "Release address (`https://.../<version>/<file>` is a release file); empty for none.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Vault": {
      "additionalProperties": false,
      "description": "The project vault: recording, writing and ingestion.",
      "properties": {
        "autoRecord": {
          "default": true,
          "description": "Record sessions in the vault.",
          "type": "boolean"
        },
        "backup": {
          "default": true,
          "description": "Keep the text of a replaced block under `.laris/backups`.",
          "type": "boolean"
        },
        "ingestMaxBytes": {
          "default": 20000000,
          "description": "Largest document ingested, in bytes.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "maxNoteChars": {
          "default": 60000,
          "description": "Longest note or note block LARIS writes, in characters.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "maxWritesPerMinute": {
          "default": 120,
          "description": "Note writes allowed in a minute; 0 for no limit.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "ocr": {
          "$ref": "#/$defs/Ocr",
          "default": {
            "dpi": 200,
            "enabled": true,
            "languages": "eng",
            "maxPages": 60,
            "ocrCommand": "tesseract",
            "renderCommand": "pdftoppm",
            "textCommand": "pdftotext",
            "timeoutSeconds": 120
          },
          "description": "Reading PDFs the built-in reader cannot (scans, unusual fonts)."
        },
        "passageMaxChars": {
          "default": 1200,
          "description": "Longest passage cut from a document, in characters.",
          "format": "uint32",
          "minimum": 50,
          "type": "integer"
        },
        "searchMaxResults": {
          "default": 10,
          "description": "Passages `search_corpus` returns at most.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Web": {
      "additionalProperties": false,
      "description": "The web tools `WebSearch` and `WebFetch` (SR-H17): they run in the client, with the client's address.",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Whether the web tools are offered.",
          "type": "boolean"
        },
        "maxBytes": {
          "default": 2097152,
          "description": "Most bytes read from one page.",
          "format": "uint64",
          "minimum": 1024,
          "type": "integer"
        },
        "maxRedirects": {
          "default": 5,
          "description": "Most redirects followed; every hop is checked again.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "maxResults": {
          "default": 8,
          "description": "Most search results returned.",
          "format": "uint32",
          "minimum": 1,
          "type": "integer"
        },
        "paperSearchUrl": {
          "default": "https://api.openalex.org/works",
          "description": "Address of a scholarly works API with the OpenAlex interface (`search`, `per-page`, `filter`, `select`); no key\nis needed. Empty turns `PaperSearch` off.",
          "type": "string"
        },
        "searchUrl": {
          "default": "https://html.duckduckgo.com/html/",
          "description": "Address of the HTML search page; the query is added as `q`. Empty turns `WebSearch` off.",
          "type": "string"
        },
        "timeoutSeconds": {
          "default": 20,
          "description": "Seconds one request may take, redirects included.",
          "format": "uint64",
          "minimum": 1,
          "type": "integer"
        },
        "userAgent": {
          "default": "Mozilla/5.0 (compatible; Laris)",
          "description": "`User-Agent` sent.",
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The settings document.",
  "properties": {
    "$schema": {
      "description": "Schema reference, kept for editors.",
      "type": [
        "string",
        "null"
      ]
    },
    "agent": {
      "$ref": "#/$defs/Agent",
      "default": {
        "maxRepeatedCalls": 3,
        "maxSteps": 10,
        "maxToolCallsPerStep": 0,
        "plan": {
          "maxSteps": 12,
          "minRequestWords": 12,
          "mode": "auto",
          "stepChars": 240
        },
        "reflect": {
          "completionRetries": 2,
          "emptyKeys": [
            "hits",
            "passages",
            "results",
            "matches",
            "items"
          ],
          "enabled": true,
          "maxReplans": 2,
          "permanentErrors": [
            "no_documents",
            "search_blocked",
            "web_unavailable"
          ]
        },
        "timeBudgetSeconds": 180.0
      },
      "description": "Agent loop limits."
    },
    "cleanupPeriodDays": {
      "default": 30,
      "description": "Days to keep session data; 0 keeps none.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "context": {
      "$ref": "#/$defs/Context",
      "default": {
        "autoCompact": true,
        "compactTarget": 0.75,
        "compactThreshold": 0.8,
        "layerMaxChars": 20000,
        "layerShare": 0.25,
        "memoryMaxNotes": 50,
        "pinnedShare": 0.25,
        "reserveTokens": 4096,
        "summaryLineChars": 160,
        "summaryShare": 0.15,
        "windowTokens": 32768
      },
      "description": "Context window."
    },
    "env": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "description": "Environment variables set for tools and hooks.",
      "type": "object"
    },
    "extraInstructions": {
      "default": "",
      "description": "Instructions appended to every prompt.",
      "type": "string"
    },
    "hooks": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/HookMatcher"
        },
        "type": "array"
      },
      "default": {},
      "description": "Hooks by event; events are listed in [`HOOK_EVENTS`].",
      "type": "object"
    },
    "learning": {
      "$ref": "#/$defs/Learning",
      "default": {
        "collect": true,
        "exportMinRating": "none",
        "maxToolResultChars": 3000,
        "minAnswerChars": 40,
        "retrievalTools": [
          "search_corpus"
        ],
        "storePassageText": true,
        "storeToolResults": true
      },
      "description": "Learning data."
    },
    "mcp": {
      "$ref": "#/$defs/Mcp",
      "default": {
        "enabled": true,
        "servers": {}
      },
      "description": "MCP servers."
    },
    "model": {
      "default": "",
      "description": "Model name sent to the server; empty for the server default.",
      "type": "string"
    },
    "permissions": {
      "$ref": "#/$defs/Permissions",
      "default": {
        "additionalDirectories": [],
        "allow": [],
        "ask": [],
        "autoAsk": [
          "Bash(sudo:*)",
          "Bash(su:*)",
          "Bash(doas:*)",
          "Bash(rm -[rRf]* /*)",
          "Bash(rm -[rRf]* ~*)",
          "Bash(rm -[rRf]* ..*)",
          "Bash(rm -[rRf]* $HOME*)",
          "Bash(git push:*)",
          "Bash(git reset --hard*)",
          "Bash(git clean:*)",
          "Bash(git branch -D:*)",
          "Bash(mkfs*)",
          "Bash(dd:*)",
          "Bash(chmod -R:*)",
          "Bash(chown -R:*)",
          "Bash(shutdown:*)",
          "Bash(reboot:*)",
          "Bash(poweroff:*)",
          "Bash(halt:*)"
        ],
        "defaultMode": "auto",
        "deny": []
      },
      "description": "Permissions."
    },
    "sandbox": {
      "$ref": "#/$defs/Sandbox",
      "default": {
        "indexUrl": "",
        "inheritEnv": false,
        "packages": [],
        "python": "3.12",
        "pythonSource": ""
      },
      "description": "Sandbox."
    },
    "server": {
      "$ref": "#/$defs/Server",
      "default": {
        "caCertificateFile": "",
        "caFingerprint": "",
        "idleTimeoutSeconds": 60.0,
        "maxResponseBytes": 16777216,
        "maxRetries": 3,
        "retryBackoffMaxSeconds": 30.0,
        "retryBackoffSeconds": 1.0,
        "timeoutSeconds": 120.0,
        "url": ""
      },
      "description": "Server connection."
    },
    "statusLine": {
      "anyOf": [
        {
          "$ref": "#/$defs/StatusLine"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Status line command."
    },
    "tools": {
      "$ref": "#/$defs/Tools",
      "default": {
        "bashDefaultTimeoutSeconds": 120.0,
        "bashMaxTimeoutSeconds": 600.0,
        "bashOutputMaxChars": 30000,
        "checkpointKeep": 200,
        "deniedFiles": [
          ".env",
          ".env.*",
          "*.pem",
          "*.key",
          "id_rsa",
          "id_ed25519",
          ".netrc",
          ".npmrc",
          ".pypirc"
        ],
        "editMaxBytes": 2000000,
        "globMaxResults": 500,
        "grepMaxFileBytes": 2000000,
        "grepMaxResults": 200,
        "readMaxLines": 2000,
        "resultMaxChars": 60000,
        "skillMaxChars": 20000
      },
      "description": "Limits of the local tools and of tool results."
    },
    "ui": {
      "$ref": "#/$defs/Ui",
      "default": {
        "language": "en",
        "markdown": true,
        "showStatusLine": true,
        "spinner": true,
        "theme": "auto"
      },
      "description": "Terminal interface."
    },
    "update": {
      "$ref": "#/$defs/Update",
      "default": {
        "intervalMinutes": 360,
        "signatureVerifier": "",
        "url": ""
      },
      "description": "Automatic updates of the client (always on; this says where the releases are)."
    },
    "vault": {
      "$ref": "#/$defs/Vault",
      "default": {
        "autoRecord": true,
        "backup": true,
        "ingestMaxBytes": 20000000,
        "maxNoteChars": 60000,
        "maxWritesPerMinute": 120,
        "ocr": {
          "dpi": 200,
          "enabled": true,
          "languages": "eng",
          "maxPages": 60,
          "ocrCommand": "tesseract",
          "renderCommand": "pdftoppm",
          "textCommand": "pdftotext",
          "timeoutSeconds": 120
        },
        "passageMaxChars": 1200,
        "searchMaxResults": 10
      },
      "description": "Vault recording."
    },
    "web": {
      "$ref": "#/$defs/Web",
      "default": {
        "enabled": true,
        "maxBytes": 2097152,
        "maxRedirects": 5,
        "maxResults": 8,
        "paperSearchUrl": "https://api.openalex.org/works",
        "searchUrl": "https://html.duckduckgo.com/html/",
        "timeoutSeconds": 20,
        "userAgent": "Mozilla/5.0 (compatible; Laris)"
      },
      "description": "Web tools."
    }
  },
  "title": "LARIS client settings (~/.laris/settings.json)",
  "type": "object"
}
