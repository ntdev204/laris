{
  "name": "@ntdev204/laris-cli",
  "version": "1.5.2",
  "description": "LARIS terminal client: local-first research assistant. The model and system policy run on your LARIS server.",
  "license": "MIT",
  "bin": {
    "laris": "bin/laris.js"
  },
  "files": [
    "bin",
    "scripts",
    "build/src",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntdev204/laris.git"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test --test-timeout=60000 --test-reporter=spec \"build/test/*.test.js\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ink": "8.0.0",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "ink-testing-library": "4.0.0",
    "typescript": "7.0.2"
  },
  "type": "module"
}
