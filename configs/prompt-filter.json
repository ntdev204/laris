 "injection": {
  "policy_file": ".laris/prefilter.toml",
  "policy_kinds": [
   "injection",
   "refusal"
  ],
  "rules": [
   {
    "id": "ignore_instructions",
    "pattern": "\\b(ignore|disregard|forget|override|bypass|skip)\\b.{0,40}\\b(previous|prior|above|earlier|preceding|all|any|your|the system|system|original)\\b.{0,30}\\b(instructions?|rules?|prompts?|guidelines?|constraints?|directions?|directives?|messages?)\\b"
   },
   {
    "id": "ignore_everything",
    "pattern": "\\b(ignore|disregard|forget)\\s+(everything|all of (this|that|the above)|what (you were|i) (told|said))\\b"
   },
   {
    "id": "ignore_above_and_act",
    "pattern": "\\b(ignore|disregard|forget)\\s+(the|all|everything)?\\s*(above|preceding|previous|prior)\\s*(text|message|prompt|content)?\\s*(and|,|;|\\.)\\s*(instead\\s+)?(do|answer|say|print|output|write|just|respond|reply|tell)\\b"
   },
   {
    "id": "do_as_i_say",
    "pattern": "\\bdo (exactly )?(as|what) i (say|tell you)\\b"
   },
   {
    "id": "new_persona",
    "pattern": "\\byou are (now|no longer)\\b|\\bfrom now on,? you (are|will|must)\\b|\\b(developer|god|jailbreak|dan|unrestricted|unfiltered|admin|debug) mode\\b|\\bact as (an? )?(unrestricted|unfiltered|jailbroken|evil)\\b|\\bpretend (that )?(you are|to be)\\b.{0,60}\\b(no|without|free of) (rules|restrictions|limits|filters|guidelines)\\b"
   },
   {
    "id": "reveal_instructions",
    "pattern": "\\b(reveal|show|print|repeat|display|leak|tell me|output|dump|share|recite|write out)\\b.{0,30}\\b(system prompt|system message|developer message|your prompt|your instructions|hidden instructions|initial instructions|internal rules|instructions you were given|configuration|pre-?prompt)\\b"
   },
   {
    "id": "role_markers",
    "pattern": "<\\|?(im_start|im_end|system|assistant|endoftext|eot_id|start_header_id)\\|?>|\\[/?inst\\]|<<\\s*/?sys\\s*>>|(^|\\n)\\s*#{1,6}\\s*(system|assistant|developer|instruction)s?\\s*:|(^|\\n)\\s*(system|developer)\\s*(message|prompt)?\\s*:"
   },
   {
    "id": "forced_answer",
    "pattern": "\\b(answer|output|print|respond with|reply with|choose|select|pick|say|write)\\b.{0,40}\\b(regardless|no matter (what|the question)|whatever the question|irrespective of|without (reading|solving|thinking|checking))\\b"
   },
   {
    "id": "given_answer_key",
    "pattern": "\\b(the )?(grader|answer key|evaluator|examiner|benchmark|marking scheme|teacher)\\b.{0,40}\\b(says|said|expects|wants|marks|requires|lists)\\b.{0,30}\\b(answer|option|choice)\\b|\\b(correct|right|expected) (answer|option|choice) is\\s*\\(?[a-j]\\)?\\s*[.;,:]?\\s*(just|simply|only|so)?\\s*(print|output|say|write|answer|respond|reply|return)\\b"
   },
   {
    "id": "tool_or_shell",
    "pattern": "\\b(run|execute|call|invoke)\\b.{0,25}\\b(shell|bash|terminal|sudo|rm -rf|powershell|cmd\\.exe|os\\.system|subprocess|the tool|a tool|tool call|function call)\\b(?!.{0,20}\\b(output|outputs|prints?|returns?|display|displays)\\b)|\\b(open|read|cat|access|fetch|download|curl|wget|upload|send)\\b.{0,30}(/etc/|~/|\\.env\\b|id_rsa|passwd|api[_ ]?keys?|password file|secrets? file|your files|the server|my files)"
   },
   {
    "id": "vi_injection",
    "pattern": "\\b(bỏ qua|phớt lờ|quên)\\b.{0,30}\\b(mọi|tất cả|các)?\\s*(chỉ dẫn|hướng dẫn|lệnh|quy tắc|chỉ thị|yêu cầu)\\b.{0,20}\\b(trước|trên|hệ thống|ban đầu)|\\b(tiết lộ|cho (tôi )?xem|in ra|hiển thị)\\b.{0,30}\\b(system prompt|lời nhắc hệ thống|chỉ dẫn (nội bộ|hệ thống|ẩn)|quy tắc nội bộ)\\b|\\bbạn (bây giờ|giờ) là\\b|\\bchế độ (nhà phát triển|không giới hạn)\\b"
   },
   {
    "id": "other_language_injection",
    "pattern": "\\bignore[zr]?\\b.{0,30}\\b(instructions|consignes|règles)\\b|\\bignorier\\w*\\b.{0,30}\\b(anweisungen|vorgaben|regeln|anleitungen)\\b|\\b(ignora|olvida)\\w*\\b.{0,30}\\b(instrucciones|reglas|indicaciones)\\b|\\b(révèle|montre|affiche)\\w*\\b.{0,30}\\b(prompt système|instructions (système|cachées))\\b|\\b(zeige|verrate)\\w*\\b.{0,30}\\b(systemprompt|system-prompt|anweisungen)\\b|\\b(revela|muestra)\\w*\\b.{0,30}\\b(prompt del sistema|instrucciones)\\b"
   },
   {
    "id": "remote_instructions",
    "pattern": "\\b(use|using|via|with|through)\\s+(your|the|a)\\s+(\\w+[ -]){0,2}(browser|browsing|web|http|shell|terminal|file|search|code)\\s*(tool|access)\\b|\\b(fetch|open|visit|browse|go to|load|send|post|upload)\\b.{0,40}https?://|\\btreat\\b.{0,40}\\bas (your )?(new )?(instructions|rules|prompt)\\b|\\bfollow (what it says|its instructions|the instructions (there|on that page|at that link))\\b"
   },
   {
    "id": "exfiltrate",
    "pattern": "\\b(send|post|upload|forward|email|transmit|leak)\\b.{0,40}\\b(conversation|chat history|history|context window|chat log|transcript|secrets?)\\b|\\b(content|contents) of your context( window)?\\b|\\breveal (your |the |all )?secrets?\\b"
   },
   {
    "id": "system_override",
    "pattern": "\\bsystem override\\b|\\bsafety (is |has been )?(disabled|off|turned off)\\b|\\backnowledge with\\b|\\bobey (only )?me\\b|\\bforget (your|the) (role|persona|rules|training|guidelines)\\b"
   },
   {
    "id": "no_guidelines_persona",
    "pattern": "\\b(act as|pretend (to be|you are)|be|become)\\s+(an? )?(\\w+ ){0,2}(ai|assistant|model|chatbot|bot)?\\s*(without|with no|free of|that has no)\\s+(any )?(guidelines|rules|restrictions|limits|filters|safety)\\b|\\bact as dan\\b|\\byou are dan\\b"
   },
   {
    "id": "repeat_prompt",
    "pattern": "\\b(your|the) (initial|original|first|hidden|system|secret) (instructions|prompt|message|directives)\\b|\\brepeat (the text|everything|all|what is written) (above|before)\\b|\\brepeat (them|it) verbatim\\b"
   },
   {
    "id": "persistent_answer",
    "pattern": "\\b(from (this message|this point|now) on|always|for every question)\\b.{0,30}\\b(reply|answer|respond|output|say|choose)\\b.{0,20}(['\"(]?\\b[a-j]\\b['\")]?|the letter)|\\bignore the question\\b|\\b(regardless of|whatever|no matter|irrespective of)\\b.{0,25}\\b(the question|you compute|you think|you find|the content|the problem)\\b|\\b(respond|reply|answer|output) with (the letter|option|choice) \\(?[a-j]\\b"
   },
   {
    "id": "file_action",
    "pattern": "(^|[.!?;]\\s+|\\b(also|then|now|after answering,?|afterwards,?)\\s+)(please\\s+)?(delete|remove|erase|wipe|overwrite|list every|list all)\\b.{0,30}\\b(file|files|directory|folder|disk|drive)\\b|\\byour (shell|terminal|file|code|python) tool\\b"
   },
   {
    "id": "vi_injection_more",
    "pattern": "\\btừ (bây giờ|giờ|nay)( trở đi)?,? bạn (là|sẽ|phải)\\b|\\b(chạy|thực thi)\\s+(lệnh|câu lệnh|script)\\b|\\bluôn (luôn )?trả lời\\b.{0,20}\\b(đáp án|phương án|chữ)\\b|\\bbất kể (nội dung|câu hỏi)\\b|\\bkhông có (bất kỳ |bất cứ )?giới hạn\\b"
   },
   {
    "id": "de_more",
    "pattern": "\\b(vergiss|vergessen sie)\\b.{0,30}\\b(anweisungen|vorgaben|regeln)\\b|\\bgib\\b.{0,20}\\b(deine|ihre) (konfiguration|anweisungen|systemprompt)\\b"
   }
  ]
 },
 "scope": {
  "min_chars": 3,
  "policy_file": ".laris/prefilter.toml",
  "policy_kinds": [
   "greeting",
   "help",
   "version"
  ],
  "only_url": "^\\s*(https?://|www\\.)\\S+\\s*$",
  "no_content": "^[^\\w]*$",
  "gibberish": {
   "max_consonant_run": 5,
   "min_share": 0.5,
   "min_tokens": 1
  },
  "hard": [
   {
    "id": "chit_chat",
    "pattern": "^\\W*(how are you|how's it going|what's up|whats up|good night|thanks?( you)?|thank you( so much)?|nice to meet you|who are you|what is your name|tell me (a joke|about yourself)|i('| a)m bored|lol|ok(ay)?|bye|goodbye)\\W*$"
   },
   {
    "id": "creative_writing",
    "pattern": "^\\W*(please |can you |could you |would you |kindly )?(write|compose|draft|create|generate|give me|make)\\b.{0,40}\\b(poem|haiku|limerick|sonnet|story|short story|novel|song|lyrics|rap|essay|joke|tweet|slogan|advert\\w*|ad copy|marketing|product description|cover letter|love letter|speech|toast|caption|blog post|review)\\b"
   },
   {
    "id": "creative_writing_vi",
    "pattern": "^\\W*(hãy |làm ơn )?(viết|sáng tác|làm)\\b.{0,30}\\b(bài thơ|thơ|truyện|bài hát|lời bài hát|bài văn|câu chuyện)\\b"
   },
   {
    "id": "identity",
    "pattern": "\\b(what|which) (version|model|llm)\\b.{0,25}\\b(are you|you running|is this|do you use)\\b|\\bwho (made|created|built|trained|developed) you\\b|\\bwhat can you do\\b"
   },
   {
    "id": "personal_advice",
    "pattern": "\\b(should i|can i|do i need to|what should i|is it (ok|okay|safe) for me to|how (much|many) should i|do i have|tôi có nên)\\b.{0,80}\\b(invest|buy|sell|stocks?|crypto|bitcoin|loan|mortgage|sue|lawyer|lawsuit|divorce|landlord|tax(es)?|double|dose|medication|pills?|doctor|diet|quit|break up|cancer|sign|contract|vay|mua nhà)\\b|\\bmy (doctor|lawyer|landlord|boss|wife|husband|girlfriend|boyfriend|partner|symptoms?|rash|headache|lawsuit|portfolio|savings|children|kids)\\b|\\b(custody|non-compete)\\b|\\bi (have|'ve) (had |got )?(a |an )?(headache|fever|pain|rash|lump|cough|sore throat|toothache)\\b|\\bshould i take\\b"
   },
   {
    "id": "opinion",
    "pattern": "\\bwhat do you think (of|about)\\b|\\byour (personal )?opinion\\b|\\bbạn nghĩ gì về\\b|\\bwho will win\\b|\\bwho should i vote\\b"
   }
  ],
  "soft": [
   {
    "id": "opinion_or_politics",
    "pattern": "\\b(who will win|who should i vote|what do you think (of|about)|your (personal )?opinion|do you like|your favou?rite|which (party|candidate)|is (he|she|they) (a )?(good|bad) (person|president|leader))\\b|\\b(election|president|prime minister|senator|political party|celebrity|kardashian|taylor swift|football match|world cup)\\b"
   },
   {
    "id": "translation_request",
    "pattern": "^\\W*(please |can you |could you )?translate\\b"
   },
   {
    "id": "recipe_or_travel",
    "pattern": "\\b(recipe for|how do i cook|best restaurant|plan (a|my) (trip|vacation|holiday)|book (a )?(flight|hotel)|travel itinerary)\\b"
   },
   {
    "id": "small_talk",
    "pattern": "^\\W*(hi|hello|hey|hiya|good (morning|afternoon|evening|night)|thanks|thank you|xin chào|chào|bonjour|hola|hallo|ciao|what's up|whats up)\\b|\\bhow are you\\b|\\bnice to meet you\\b|\\bbạn (có )?khỏe không\\b|\\bça va\\b|\\bjust wanted to chat\\b|\\bhave a (great|nice|good) (day|weekend|week)\\b"
   },
   {
    "id": "translation_vi",
    "pattern": "^\\W*(hãy )?dịch\\b|\\bdịch sang tiếng\\b"
   },
   {
    "id": "recommendation",
    "pattern": "\\brecommend (me )?(a |an |some )?(\\w+ ){0,2}(series|movie|film|book|show|song|restaurant|game)\\b|\\bnetflix\\b|\\bwhat should i (cook|eat|watch|wear|read|buy)\\b|\\bplan an? (\\w+[- ]){0,2}(trip|vacation|holiday)\\b"
