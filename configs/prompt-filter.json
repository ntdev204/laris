{
 "version": "1",
 "note": "T286: the prompt filter of the evaluation profile. Every prompt passes it before retrieval, the router and the model. Deterministic and model-free; it never answers and never reads the gold answer. Patterns are Python regular expressions matched, case-insensitively, on the folded view of the prompt (NFKC, case folded, zero-width characters dropped, whitespace collapsed); the text handed on is only the normalised one. The first stop rule that matches wins; every stop and every change names its rule.",
 "normalise": {
  "unicode_form": "NFC",
  "zero_width": [
   "​",
   "‌",
   "‍",
   "⁠",
   "﻿",
   "­"
  ],
  "spaces": [
   " ",
   " ",
   " ",
   " ",
   " ",
   " ",
   " ",
   " ",
   " ",
   " ",
   " ",
   " ",
   "　",
   "\t"
  ],
  "max_blank_lines": 1,
  "latex": [
   {
    "rule": "latex_dfrac",
    "pattern": "\\\\[dt]frac(?![A-Za-z])",
    "replacement": "\\\\frac"
   },
   {
    "rule": "latex_double_dollar_join",
    "pattern": "\\$\\$(?=\\\\(?:mu|mathrm|text|,))",
    "replacement": " "
   }
  ],
  "despace_min_letters": 4
 },
