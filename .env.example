# Copy to .env (git-ignored) and fill in. Only variables you need; everything has a default in
# configs/default.yaml. Nested keys use a double underscore: LARIS_<SECTION>__<KEY>.
# Secrets belong here or in the shell, never in YAML.

# Model API the agent calls (empty = built-in offline planner)
LARIS_MODEL_API__BASE_URL=
LARIS_MODEL_API__MODEL=laris-core
# Client: the user's API key is entered with `laris login` or set as LARIS_API_KEY (never in files).
# LARIS_API_KEY=
# Internal prompts may only be sent to loopback hosts unless this is true
LARIS_MODEL_API__ALLOW_REMOTE=false

# Agent loop and context
# LARIS_AGENT__MAX_STEPS=10
# LARIS_AGENT__TIME_BUDGET_S=180
# LARIS_AGENT__APPROVAL__MODE=ask
# LARIS_CONTEXT__WINDOW_TOKENS=32768
# LARIS_CONTEXT__ENABLED=true

# Model server (operator): accepted keys, comma separated; the server refuses to start without any.
# LARIS_SERVING__PORT=8000
# LARIS_SERVER_KEYS=test-key-one,test-key-two

# Extra environment variables whose values must never reach model output (JSON list)
# LARIS_SECURITY__EXTRA_SECRET_ENV=["MY_INTERNAL_TOKEN"]

# Learning (fine-tune data stays local; see docs/architecture/AGENT_HARNESS.md)
# LARIS_LEARNING__ENABLED=true
# LARIS_LEARNING__SKILL_ON_INGEST=true
# LARIS_LEARNING__STORE_PASSAGE_TEXT=true
