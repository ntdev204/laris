# Copy to docker/laris.env (git-ignored). Every line is optional; the script finds sensible values itself.
# The name clients use. Empty: the tailnet name of this machine when Tailscale HTTPS is on, else localhost.
# LARIS_DOMAIN=vthlab.tail3e814e.ts.net
LARIS_HTTPS_PORT=38443
LARIS_HTTP_PORT=38080
# Hugging Face hub cache that holds models--Qwen--Qwen3.5-4B (mounted read-only into the model container)
# LARIS_MODELS_DIR=/home/vth/.cache/huggingface/hub
# Server tools (T273): the web chat searches OpenAlex and the web and reads PDFs on the server. Gives the server
# (only) a route out to public addresses; off by default.
# LARIS_SERVER_TOOLS=true
# STEM evaluation (T275, T278): opens the vLLM server on 127.0.0.1 at this port. The one place the port is set:
# docker/laris.sh and scripts/stem_benchmarks.py both read it from this file. Unset: the port stays closed.
# LARIS_ENGINE_PORT=38100
