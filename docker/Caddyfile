# The only public entry (SR-S8). TLS ends here. `LARIS_DOMAIN=localhost` (or an IP address) uses Caddy's own
# authority, kept in the `caddy_data` volume; a real name gets a public certificate. laris-server sees plain HTTP
# on the internal network only.
{
	# a client that connects to an IP address sends no server name; give it the certificate of the domain
	default_sni {$LARIS_DOMAIN:localhost}
	servers {
		timeouts {
			read_body 30s
			read_header 10s
			idle 2m
		}
	}
}

{$LARIS_DOMAIN:localhost} {
	# a certificate you hold (for example `tailscale cert`): docker/tls/*.caddy holds `tls CERT KEY`; with none the
	# domain gets Caddy's own authority or a public certificate, as above
	import /etc/caddy/tls/*.caddy

	encode zstd gzip

	request_body {
		max_size 32MB
	}

	# The public half of Caddy's authority, so a client can pin it (the rewrite names one file: the keys beside it
	# are never served). With a public certificate the file does not exist: 404.
	@authority path /.well-known/laris/ca.crt
	handle @authority {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		file_server
	}

	# chat streams over SSE: never buffer; no write timeout (it would cut a long answer), the server owns its limits
	reverse_proxy server:8080 {
		flush_interval -1
		transport http {
			dial_timeout 5s
			response_header_timeout 300s
			read_timeout 600s
		}
		health_uri /health
		health_interval 15s
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}

	log {
		output stdout
		format filter {
			wrap json
			request>headers>Authorization delete
		}
	}
}
