# TLS terminates here. `LARIS_DOMAIN=localhost` uses Caddy's local CA; a real name gets a public
# certificate automatically. The API sees only plain HTTP on the internal network.
# Slow clients: Caddy's defaults wait for a TLS handshake, a header or a body for ever, so a few
# hundred half-open connections would hold every socket. `read_body` also bounds the TLS handshake.
# No write timeout: it would cut a long server-sent-events answer.
{
	# a client that connects to an IP address (a private network such as Tailscale) sends no server
	# name; serve the certificate of the configured domain to it instead of failing the handshake
	default_sni {$LARIS_DOMAIN:localhost}
	servers {
		timeouts {
			read_body 30s
			read_header 10s
			idle 2m
		}
	}
}

{$LARIS_DOMAIN:localhost} {
	encode zstd gzip

	# the server enforces its own limit as well; this stops oversize bodies at the edge
	request_body {
		max_size 32MB
	}

	# The certificate of Caddy's own authority (the public half only; the rewrite names one file, so
	# the keys beside it can never be served). A client pins this instead of the server certificate,
	# which is renewed every few hours. With a public certificate the file does not exist: 404.
	@authority path /.well-known/laris/ca.crt
	handle @authority {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		file_server
	}

	reverse_proxy api:8000 {
		# server-sent events: send each chunk at once instead of buffering the answer
		flush_interval -1
		transport http {
			dial_timeout 5s
			response_header_timeout 300s
			read_timeout 600s
			write_timeout 60s
		}
		health_uri /health
		health_interval 15s
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}

	log {
		output stdout
		format filter {
			wrap json
			request>headers>Authorization delete
		}
	}
}
