# TLS terminates here. `LARIS_DOMAIN=localhost` uses Caddy's local CA; a real name gets a public
# certificate automatically. The API sees only plain HTTP on the internal network.
{$LARIS_DOMAIN:localhost} {
	encode zstd gzip

	# the server enforces its own limit as well; this stops oversize bodies at the edge
	request_body {
		max_size 32MB
	}

	reverse_proxy api:8000 {
		# server-sent events: send each chunk at once instead of buffering the answer
		flush_interval -1
		transport http {
			dial_timeout 5s
			response_header_timeout 300s
			read_timeout 600s
			write_timeout 60s
		}
		health_uri /health
		health_interval 15s
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}

	log {
		output stdout
		format filter {
			wrap json
			request>headers>Authorization delete
		}
	}
}
