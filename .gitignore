# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
laris-env/

# Testing & Type Checking
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Model Checkpoints & Large Neural Weights (Store on SSD / DVC, not Git)
artifacts/checkpoints/*
!artifacts/checkpoints/.gitkeep
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.gguf

# Run outputs (tokenizer, evaluation reports, run logs)
artifacts/*
!artifacts/README.md
!artifacts/checkpoints/.gitkeep

# Temporary and background-run files
*.tmp
nohup.out

# Raw & Processed Datasets (Corpora must not be tracked in Git)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/cache/*
!data/cache/.gitkeep

# System & IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
LARIS.local.md

# Generated from local documents (user data)
.laris/skills/corpus-*/
.laris/memory/
packaging/npm/vendor/
docker/secrets/
packaging/npm/node_modules/
/target

# Release signing keys never go into Git (T159).
release.key
*.release.key

# Vendored crates are kept exactly as published: their checksums list every file (T159)
!/vendor/
!/vendor/**

# Decision datasets (T168/T170): built from logs and scenarios, kept outside Git
data/decision/
docker/tls/*
!docker/tls/.gitkeep
docker/laris.env

# STEM benchmark data, splits and run records (T275, ADR-026): outside Git; GPQA text never in Git
data/benchmarks/

# Main-brain sources and snapshots (T277): textbooks, built vaults; outside Git
data/brain/
